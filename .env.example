# SignalMesh Terminal — its OWN configuration (prefix SMT_). Copy to .env.
# Nothing here is shared with SignalMesh's BB_* .env, and nothing here can write.

SMT_PROVIDER=signalmesh                 # signalmesh | fixture (fixture = dev only; refused in production)
SMT_SIGNALMESH_URL=http://app:8000      # SignalMesh app container, reached over its docker network (see docker-compose.yml)
SMT_SIGNALMESH_API_KEY=                 # READ-ONLY key: SignalMesh Dashboard -> API -> new key -> permissions "read"
SMT_SYMBOLS=                            # optional pins; empty = every instrument SignalMesh has candles for (discovered automatically)
SMT_DEFAULT_SYMBOL=GOLD
SMT_CACHE_TTL_S=15                      # one upstream read is reused this long
SMT_POLL_S=15                           # UI poll interval
SMT_AUTH=signalmesh                     # signalmesh = same login as SignalMesh (session cookie checked) | token | open (dev only)
SMT_ACCESS_TOKEN=                       # only for SMT_AUTH=token
SMT_EXECUTION_ENABLED=false             # Phase 6 only; order placement refuses regardless in this phase
SMT_ENV=production

# docker-compose only: the SignalMesh compose network to join (docker network ls)
SIGNALMESH_NETWORK=brotherbot_default
