    # SignalMesh Terminal — separate container, same site, same login. These two
    # location blocks go inside the HTTPS server block of the SignalMesh site
    # (scripts/setup.sh inserts them). The trailing slash on proxy_pass strips the
    # /terminal/ prefix, so the terminal container sees "/" exactly as standalone.
    location = /terminal { return 301 /terminal/; }
    location /terminal/ {
        proxy_pass http://127.0.0.1:8090/;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_read_timeout 120s;
        add_header Cache-Control "no-store" always;
    }
